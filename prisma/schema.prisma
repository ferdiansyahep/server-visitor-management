generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visitor {
  id           Int      @id @default(autoincrement())
  nama         String
  nik          String
  tujuan       String
  fotoUrl      String?
  waktuMasuk   DateTime @default(now())
  statusRisiko String

  @@map("visitors")
}